a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043b\u044e\u0431\u0430\u044f \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u0440\u0430\u0431\u0438\u043a\u0430, \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u0430\u044f \u0432 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438, \u043e\u0442\u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0443. \u041f\u0440\u043e\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f <strong>\u0421\u0430\u043d\u0442\u043e\u0441 = \u0410\u0440\u0430\u0431\u0438\u043a\u0430 \u0438\u0437 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438<\/strong>.<\/p><p><br><\/p><p>\u041c\u0435\u0448\u043a\u0438 \u0441 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u043d\u0430\u0448\u0438\u043c \u043b\u043e\u0442\u043e\u043c \u0431\u044b\u043b\u0438 \u043f\u043e\u043c\u0435\u0447\u0435\u043d\u044b \u043e\u0442\u043c\u0435\u0442\u043a\u043e\u0439 \"\u0421\u0443\u043b\u044c-\u0434\u0435-\u041c\u0438\u043d\u0430\u0441\". \u042d\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043a\u043e\u0444\u0435 \u043f\u0440\u0438\u0431\u044b\u043b \u0441&nbsp;\u0421\u0443\u043b\u044c-\u0434\u0435-\u041c\u0438\u043d\u0430\u0441 \u2013 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u0440\u0435\u0433\u0438\u043e\u043d\u0430, \u0438\u043b\u0438 \u0442\u0435\u0440\u0440\u0443\u0430\u0440\u0430. \u0412 \u043d\u0430\u0448\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u2014 \u044d\u0442\u043e \u044e\u0436\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c (Sul = \u042e\u0433) \u0448\u0442\u0430\u0442\u0430 \u041c\u0438\u043d\u0430\u0441-\u0416\u0435\u0440\u0430\u0439\u0441 (Minas Gerais)<\/p><p><br><\/p><p>\u041e\u0447\u0435\u043d\u044c \u043f\u043e\u043b\u0435\u0437\u043d\u043e \u0437\u043d\u0430\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0433\u043e \u0441\u043e\u0440\u0442\u0430 \u0421\u0430\u043d\u0442\u043e\u0441\u0430:<\/p><p>&nbsp;<\/p><ul><li><strong>FC \u2013 Fine Cup<\/strong>: \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f \u0447\u0430\u0448\u043a\u0430. \u042d\u0442\u043e \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u0430\u044f, \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0437\u0435\u0440\u043d\u0430, \u043f\u0435\u0440\u0435\u043a\u043b\u0438\u043a\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0441 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u0439. \u0412\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043e \u0438\u0442\u043e\u0433\u0443 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043d\u043e\u0433\u043e \u043a\u0430\u043f\u043f\u0438\u043d\u0433\u0430 \u0432 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438. Fine Cup \u2013 6 \u0438\u0437 6 \u0447\u0430\u0448\u0435\u043a \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0443 Mole = \u00ab\u043c\u044f\u0433\u043a\u0438\u0439, \u0447\u0438\u0441\u0442\u044b\u0439, \u0441\u043b\u0430\u0434\u043a\u0438\u0439\u00bb. \u0415\u0441\u043b\u0438 \u0445\u043e\u0442\u044c \u043e\u0434\u043d\u0430 \u0447\u0430\u0448\u043a\u0430 \u043d\u0435 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u043e\u0442\u043b\u0438\u0447\u043d\u043e, \u0442\u043e \u0437\u0435\u0440\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u043e\u0446\u0435\u043d\u043a\u0443 GC = Good Cup.<\/li><li><strong>17\/18<\/strong> \u2013 \u0441\u043a\u0440\u0438\u043d, \u043e\u043d \u0436\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u0437\u0435\u043b\u0435\u043d\u043e\u0433\u043e \u0437\u0435\u0440\u043d\u0430, \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u044d\u0442\u043e \u2013 6,5-7 \u043c\u043c, \u0432 \u043e\u0431\u0436\u0430\u0440\u0435\u043d\u043d\u043e\u043c \u0432\u0438\u0434\u0435 12-15 \u043c\u043c. \u0411\u044b\u0432\u0430\u0435\u0442 \u043c\u0435\u043b\u044c\u0447\u0435 \u2013 14\/16 (\u0437\u0435\u043b\u0435\u043d\u043a\u0430 5-6 \u043c\u043c, \u0431\u043e\u043b\u0435\u0435 \u0442\u0435\u0440\u043f\u043a\u0438\u0439 \u0438 \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u044b\u0439) \u0438 \u043a\u0440\u0443\u043f\u043d\u0435\u0435 \u2013 19 (\u0437\u0435\u043b\u0435\u043d\u043a\u0430 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 7,5 \u043c\u043c, \u043f\u0440\u0438 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u043e\u0431\u0436\u0430\u0440\u043a\u0435 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0446\u0438\u0442\u0440\u0443\u0441\u043e\u0432\u0430\u044f \u0438 \u044f\u0433\u043e\u0434\u043d\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u044c). \u041e\u0431\u044b\u0447\u043d\u043e \u043a\u0440\u0443\u043f\u043d\u0435\u0435 = \u043b\u0443\u0447\u0448\u0435, \u0432 \u0442\u043e\u043c \u043f\u043b\u0430\u043d\u0435, \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0434\u0435\u0441\u043a\u0440\u0438\u043f\u0442\u043e\u0440\u043e\u0432 (\u0432\u043a\u0443\u0441\u043e\u0432\u044b\u0445 \u043e\u0442\u0442\u0435\u043d\u043a\u043e\u0432), \u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0441\u0442\u0440\u0430\u043d \u0438 \u0440\u0430\u0437\u043d\u043e\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u0435\u0439, \u043d\u043e \u0434\u043b\u044f \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438 \u2013 \u0442\u0430\u043a.<\/li><li><strong>NY2<\/strong> \u2013 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0434\u0435\u0444\u0435\u043a\u0442\u043e\u0432 \u043f\u043e \u0448\u043a\u0430\u043b\u0435 \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0441\u043a\u043e\u0439 \u0431\u0438\u0440\u0436\u0438 (NY) \u043d\u0430 300-\u0433\u0440\u0430\u043c\u043c\u043e\u0432\u044b\u0439 \u043e\u0431\u0440\u0430\u0437\u0435\u0446 \u0437\u0435\u043b\u0435\u043d\u043e\u0433\u043e \u043a\u043e\u0444\u0435. NY2 \u2013 \u0432\u044b\u0441\u0448\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c: \u043e\u0442 0 \u0434\u043e 4 \u043f\u043e\u043b\u043d\u044b\u0445 \u0434\u0435\u0444\u0435\u043a\u0442\u043e\u0432. \u0414\u0435\u0444\u0435\u043a\u0442\u044b \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u043f\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u0435, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0437\u0430\u043a\u0438\u0441\u0448\u0435\u0435 \u0437\u0435\u0440\u043d\u043e \u2013 1 \u043f\u043e\u043b\u043d\u044b\u0439 \u0434\u0435\u0444\u0435\u043a\u0442, \u043f\u043e\u0433\u0440\u044b\u0437\u043b\u0438 \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u044b\u0435 \u2013 \u043d\u0435\u043f\u043e\u043b\u043d\u044b\u0439. \u0422\u0430\u043c \u043d\u0435\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u0435 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u044b. \u041d\u043e \u0435\u0441\u0442\u044c \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u0447\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u2013 \u0442\u0435\u043c \u0445\u0443\u0436\u0435. \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0433\u0440\u0430\u0434\u0430\u0446\u0438\u0438:<\/li><li><strong>NY 2\/3<\/strong>&nbsp;\u2014 \u043e\u0442&nbsp;5&nbsp;\u0434\u043e&nbsp;8&nbsp;\u043f\u043e\u043b\u043d\u044b\u0445 \u0434\u0435\u0444\u0435\u043a\u0442\u043e\u0432.<\/li><li><strong>NY 3\/4<\/strong> \u2014 \u043e\u0442&nbsp;9&nbsp;\u0434\u043e&nbsp;19&nbs
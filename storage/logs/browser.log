43\u043c\u0431\u0438\u044f \u0421\u0443\u043f\u0440\u0435\u043c\u043e \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043b\u044e\u0431\u0438\u043c\u044b\u0445 \u043d\u0430\u0448\u0438\u0445 \u0441\u043e\u0440\u0442\u043e\u0432. \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u044f \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u043a\u043e\u0444\u0435 \u0432 \u043c\u0438\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438, \u0412\u044c\u0435\u0442\u043d\u0430\u043c\u0430 \u0438 \u0418\u043d\u0434\u043e\u043d\u0435\u0437\u0438\u0438. \u0421\u0443\u043f\u0440\u0435\u043c\u043e \u0432 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0438 \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0440\u0430\u0437\u043c\u0435\u0440 \u0437\u0451\u0440\u0435\u043d, \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043d\u043e\u0441\u043e\u0440\u0442 \u043a\u043e\u0444\u0435 \u0438\u043c\u0435\u0435\u0442 \u0441\u0430\u043c\u044b\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0437\u0435\u0440\u043d\u0430 \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u0438, c\u043a\u0440\u0438\u043d 17-20 (\u043e\u0442 6,75 \u0434\u043e 8 \u043c\u0438\u043b\u043b\u0438\u043c\u0435\u0442\u0440\u043e\u0432). \u0414\u043b\u044f \u043a\u043e\u043b\u0443\u043c\u0431\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0444\u0435 \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0437\u0435\u0440\u043d\u043e \u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430 (\u0441\u043a\u0440\u0438\u043d \u043d\u0438\u0436\u0435 17) \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u042d\u043a\u0441\u0435\u043b\u044c\u0441\u043e (Excelso).<\/p><p><br><\/p><p>\u041a\u043e\u043b\u0443\u043c\u0431\u0438\u044f \u0421\u0443\u043f\u0440\u0435\u043c\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442 \u043a \u043d\u0430\u043c \u0438\u0437 \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430 \u0414\u043e\u043b\u043e\u0440\u0435\u0441, \u0448\u0442\u0430\u0442\u0430 \u0422\u043e\u043b\u0438\u043c\u0430 \u2014 \u044d\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043a\u043e\u0444\u0435\u0439\u043d\u044b\u0445 \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u043e\u0432 \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u0438. \u041c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0433\u043e\u0440\u043d\u044b\u0445 \u0441\u043a\u043b\u043e\u043d\u043e\u0432 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u043f\u043e\u0447\u0432\u043e\u0439, \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u043e\u0439 \u043e\u0441\u0430\u0434\u043e\u0447\u043d\u044b\u043c\u0438 \u0438 \u0432\u0443\u043b\u043a\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043f\u043e\u0440\u043e\u0434\u0430\u043c\u0438, \u0434\u0435\u043b\u0430\u044e\u0442 \u043a\u043e\u0444\u0435 \u044f\u0440\u043a\u0438\u043c, \u0441\u043e\u0447\u043d\u044b\u043c, \u043d\u043e \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c.<\/p><p>&nbsp;<\/p><p>\u041a\u043e\u0444\u0435 \u0432 \u0437\u0451\u0440\u043d\u0430\u0445 \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u044f \u0421\u0443\u043f\u0440\u0435\u043c\u043e - \u044d\u0442\u043e \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0439 \u0432\u044b\u0431\u043e\u0440 \u0434\u043b\u044f \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u0439 \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u043e\u0433\u043e \u0438 \u0430\u0440\u043e\u043c\u0430\u0442\u043d\u043e\u0433\u043e \u043a\u043e\u0444\u0435. \u042d\u0442\u043e\u0442 \u043a\u043e\u0444\u0435 \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u044f\u0440\u043a\u0438\u043c \u0432\u043a\u0443\u0441\u043e\u043c \u0441 \u043e\u0442\u0442\u0435\u043d\u043a\u0430\u043c\u0438 \u0448\u043e\u043a\u043e\u043b\u0430\u0434\u0430 \u0438 \u0444\u0440\u0443\u043a\u0442\u043e\u0432, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c \u0430\u0440\u043e\u043c\u0430\u0442\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u043f\u043e\u043b\u043d\u0438\u0442 \u0432\u0430\u0448 \u0434\u043e\u043c \u0438\u043b\u0438 \u043e\u0444\u0438\u0441. \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u044f \u0421\u0443\u043f\u0440\u0435\u043c\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0434\u043b\u044f \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0430\u043a \u044d\u0441\u043f\u0440\u0435\u0441\u0441\u043e, \u0442\u0430\u043a \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0432\u0438\u0434\u043e\u0432 \u043a\u043e\u0444\u0435, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u043a\u0430\u043f\u0443\u0447\u0438\u043d\u043e \u0438\u043b\u0438 \u043b\u0430\u0442\u0442\u0435. \u0415\u0441\u043b\u0438 \u0432\u044b \u0438\u0449\u0435\u0442\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043a\u043e\u0444\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0434\u043e\u0432\u0430\u0442\u044c \u0432\u0430\u0441 \u043a\u0430\u0436\u0434\u043e\u0435 \u0443\u0442\u0440\u043e, \u0442\u043e \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u044f \u0421\u0443\u043f\u0440\u0435\u043c\u043e - \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0439 \u0432\u044b\u0431\u043e\u0440!<\/p>","productGroupId":21,"productWeight":"1","productSeller":2406},{"id":3,"created_at":"2015-02-26T17:53:00.000000Z","updated_at":"2015-02-26T17:53:00.000000Z","productCode":"uhbnik1000","productName":"\u041d\u0438\u043a\u0430\u0440\u0430